COMPOSE_PROFILES=db
UPTEMPO_MODE=single
UPTEMPO_PORT=3000
APP_URL=http://127.0.0.1:3000
BETTER_AUTH_URL=http://127.0.0.1:3000
POSTGRES_USER=uptempo
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=uptempo
DATABASE_URL=postgres://uptempo:CHANGE_ME@db:5432/uptempo
BETTER_AUTH_SECRET=CHANGE_ME
BOOKING_SESSION_SECRET=CHANGE_ME
CRON_SECRET=CHANGE_ME
STORAGE_PROVIDER=local
EMAIL_PROVIDER=console
SMS_PROVIDER=none
UPTEMPO_SOURCE_URL=https://github.com/wizard7558/uptempo
UPTEMPO_WORKER_TARGET_URL=http://web:3000

# SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Bookings <noreply@example.com>

# S3 or MinIO. Add s3 to COMPOSE_PROFILES to start MinIO.
# STORAGE_PROVIDER=s3
# S3_BUCKET=uptempo
# S3_ACCESS_KEY_ID=uptempo
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_REGION=us-east-1
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_URL=http://127.0.0.1:9000/uptempo

# Stripe. Charges go to this account. No platform fee in single mode.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Calendar. Bring your own OAuth client.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
