# Dependencies (each Capacitor app installs its own)
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Capacitor / iOS build artifacts — generated by `npx cap add ios` and Xcode.
# The native iOS project (ios/App/App, Info.plist, entitlements) IS committed;
# only generated/derived output below is ignored.
**/ios/App/Pods/
**/ios/App/build/
**/ios/App/output/
**/ios/App/Podfile.lock
**/ios/App/App/public/
**/ios/capacitor-cordova-ios-plugins/
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
xcuserdata/

# Capacitor copies the webDir here on sync (we use remote-URL mode anyway)
**/ios/App/App/capacitor.config.json

# Fastlane build output / reports (the Fastfile/Appfile ARE committed)
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/test_output/
**/fastlane/README.md
*.ipa
*.dSYM.zip
vendor/bundle/

# Secrets / local env (App Store Connect API keys, etc.)
.env
.env.*
*.p8

# macOS
.DS_Store

# Signing artifacts fastlane (cert/sigh) drops in the app dir — never commit.
*.mobileprovision
*.cer
*.certSigningRequest
*.p12
