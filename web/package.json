{
  "name": "uptempo-web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "bootstrap:check": "node scripts/check-local-bootstrap.mjs",
    "migrate:platform": "node scripts/migrate-platform.mjs",
    "migrate:tenants": "npx tsx scripts/migrate-tenants.ts",
    "migrate": "npm run migrate:platform && npm run migrate:tenants",
    "migrate:production": "node scripts/migrate-production.mjs",
    "migrate:dev-and-production": "npm run migrate && npm run migrate:production",
    "rollback:0040": "npx tsx scripts/rollback-0040.ts",
    "repair:tenants": "npx tsx scripts/repair-tenant-schemas.ts",
    "qr:generate": "npx tsx scripts/generate-qr-codes.ts",
    "brand:build": "npx tsx scripts/brand/build-brand-assets.ts",
    "marketing:screenshots": "npx tsx scripts/marketing/capture-screenshots.ts",
    "predev": "NODE_ENV=development npm run bootstrap:check && npm run migrate:tenants",
    "dev": "next dev --turbopack",
    "e2e:serve": "npx tsx scripts/seed-e2e-data.ts && npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "node --env-file=.env.local node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "test:e2e": "npx tsx scripts/seed-e2e-data.ts && npx playwright test",
    "worker": "tsx scripts/worker.ts",
    "jobs:sync": "tsx scripts/sync-vercel-crons.ts",
    "stripe:catalog": "tsx scripts/stripe/ensure-hosted-catalog.ts",
    "stripe:check-billing": "tsx scripts/stripe/check-hosted-billing.ts",
    "billing:margin": "tsx scripts/billing/processing-margin.ts",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-email/components": "^1.0.10",
    "@react-email/render": "^2.0.4",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.8.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.2",
    "@vercel/global-config": "^1.5.1",
    "@vercel/sdk": "^1.19.11",
    "@vercel/speed-insights": "^2.0.0",
    "aws4fetch": "1.0.20",
    "better-auth": "^1.4.19",
    "calendar-link": "^2.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.575.0",
    "next": "15.5.12",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "postgres": "^3.4.8",
    "postgres-range": "^1.1.4",
    "posthog-js": "^1.364.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.1.0",
    "recharts": "^3.8.1",
    "resend": "^6.9.2",
    "sonner": "^2.0.7",
    "stripe": "^20.4.0",
    "tailwind-merge": "^3.5.0",
    "twilio": "^5.12.2",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.12",
    "fast-check": "4.3.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^27.0.1",
    "prettier": "^3.8.1",
    "react-email": "^5.2.10",
    "shadcn": "^4.1.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
