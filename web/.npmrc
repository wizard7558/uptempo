# Root-level repo scripts (scripts/*.mjs) import `@next/env` directly, but pnpm
# only symlinks direct dependencies into the top-level node_modules. Hoist it so
# `npm run migrate` and `npm run dev` (predev bootstrap check) resolve it.
# The first two entries preserve pnpm's default public-hoist patterns.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@next/env
