# Emme Scheduler Environment Variables
#
# Copy this file to .env and fill in the values.
# Production values should be set via Vercel Dashboard or `vercel env add`.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Development: local PostgreSQL
# Production: use Neon pooled connection (hostname must contain -pooler, append ?sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/emme_scheduler

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Production: https://bookuptempo.com
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
RESEND_API_KEY=your-resend-api-key

# ---------------------------------------------------------------------------
# Booking
# ---------------------------------------------------------------------------
BOOKING_SESSION_SECRET=generate-with-openssl-rand-hex-32
# Optional: separate secret for /api/attachments links (defaults to BOOKING_SESSION_SECRET)
# FILE_LINK_SECRET=
# Test only (e2e): make off-session charges succeed without Stripe. Ignored in production.
# PAYMENTS_FAKE=1

# ---------------------------------------------------------------------------
# SMS (Twilio)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Required for outbound SMS (A2P / Messaging Service). Create in Twilio Console.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Vercel Blob (branding logo upload — uploadSalonLogo server action)
# ---------------------------------------------------------------------------
# From Vercel dashboard → Storage → Blob, or `vercel env pull`.
# The store must allow public blobs — booking pages load the logo with a normal <img>
# URL. A private-only store errors with "Cannot use public access on a private store".
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# ---------------------------------------------------------------------------
# Calendar (Google Calendar)
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
CRON_SECRET=optional-secret-for-cron-routes

# ---------------------------------------------------------------------------
# Domain
# ---------------------------------------------------------------------------
ROOT_DOMAIN=bookuptempo.com
# Public URL of the app (set per environment on Vercel: Production vs Preview).
# Improves better-auth client requests when the deployment URL is not localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Vercel preview (multi-tenant admin)
# ---------------------------------------------------------------------------
# Preview deployments default to tenant "test-salon" when unset. Override for a
# different preview tenant. Also set DATABASE_URL, BETTER_AUTH_URL, and
# NEXT_PUBLIC_APP_URL to the preview HTTPS URL when testing auth on Preview.
PREVIEW_TENANT_SLUG=test-salon

# Native app identifiers (keep aligned with the iOS Capacitor projects).
NATIVE_OWNER_URL_SCHEME=uptempo-owner
NATIVE_CLIENT_URL_SCHEME=uptempo-client
APNS_BUNDLE_ID_OWNER=com.uptempo.owner
APNS_BUNDLE_ID_CLIENT=com.uptempo.client
APPLE_APP_ID_OWNER=TEAMID.com.uptempo.owner
APPLE_APP_ID_CLIENT=TEAMID.com.uptempo.client

# --- core ---
# Deployment mode: multi (default, hosted platform) or single (one business). (multi: O, single: R)
# UPTEMPO_MODE=
# Runtime public base URL, read by getBaseUrl(). (multi: O, single: R)
# APP_URL=
# Dev server port. Defaults to 3000. (multi: O, single: O)
# PORT=
# Client-visible root domain for the admin sidebar. (multi: O, single: -)
# NEXT_PUBLIC_ROOT_DOMAIN=
# Public source-code URL shown by the /source route (AGPL). (multi: O, single: O)
# UPTEMPO_SOURCE_URL=
# Version string reported by /api/health. (multi: O, single: O)
# UPTEMPO_VERSION=
# Comma-separated extra origins trusted by Better Auth. (multi: O, single: O)
# AUTH_EXTRA_TRUSTED_ORIGINS=
# Set to 1 to skip the local bootstrap check (dev and CI). (multi: O, single: O)
# SKIP_BOOTSTRAP_CHECK=
# Comma-separated shard connection strings. (multi: O, single: -)
# DATABASE_SHARD_URLS=
# Shard id for newly provisioned tenants. (multi: O, single: -)
# NEW_TENANT_SHARD=
# Base URL the worker container calls for cron routes. (multi: -, single: R)
# UPTEMPO_WORKER_TARGET_URL=

# --- vercel ---
# Set by Vercel; gates Vercel Analytics and Speed Insights. Never set by hand. (multi: O, single: -)
# VERCEL=
# Set by Vercel (production, preview, development). Never set by hand. (multi: O, single: -)
# VERCEL_ENV=
# Set by Vercel: deployment hostname. Never set by hand. (multi: O, single: -)
# VERCEL_URL=
# Set by Vercel: production hostname. Never set by hand. (multi: O, single: -)
# VERCEL_PROJECT_PRODUCTION_URL=

# --- storage ---
# File storage backend: vercel-blob, local or s3. (multi: O, single: O)
# STORAGE_PROVIDER=
# Directory for the local storage provider (default /data/uploads in production, .uploads in dev). (multi: O, single: O)
# STORAGE_LOCAL_DIR=
# S3-compatible endpoint URL (required when STORAGE_PROVIDER=s3). (multi: O, single: O)
# S3_ENDPOINT=
# S3 region (default auto). (multi: O, single: O)
# S3_REGION=
# S3 bucket name (required when STORAGE_PROVIDER=s3). (multi: O, single: O)
# S3_BUCKET=
# S3 access key id (required when STORAGE_PROVIDER=s3). (multi: O, single: O)
# S3_ACCESS_KEY_ID=
# S3 secret access key (required when STORAGE_PROVIDER=s3). (multi: O, single: O)
# S3_SECRET_ACCESS_KEY=
# Public base URL for objects (required when STORAGE_PROVIDER=s3). (multi: O, single: O)
# S3_PUBLIC_URL=
# Use path-style S3 URLs (default true; MinIO and R2). (multi: O, single: O)
# S3_FORCE_PATH_STYLE=

# --- email ---
# Email backend: resend, smtp or console. (multi: O, single: O)
# EMAIL_PROVIDER=
# Default From address. (multi: O, single: O)
# EMAIL_FROM=
# SMTP host (required when EMAIL_PROVIDER=smtp). (multi: O, single: O)
# SMTP_HOST=
# SMTP port (default 587). (multi: O, single: O)
# SMTP_PORT=
# SMTP username. (multi: O, single: O)
# SMTP_USER=
# SMTP password. (multi: O, single: O)
# SMTP_PASSWORD=
# true for implicit TLS (port 465). (multi: O, single: O)
# SMTP_SECURE=
# Recipient for quiz lead notifications. (multi: O, single: -)
# QUIZ_NOTIFY_EMAIL=
# Recipient for waitlist signup notifications. (multi: O, single: -)
# WAITLIST_NOTIFY_EMAIL=

# --- sms ---
# SMS backend: twilio, loopmessage or none. (multi: O, single: O)
# SMS_PROVIDER=
# LoopMessage authorization key. (multi: O, single: -)
# LOOPMESSAGE_AUTH_KEY=
# LoopMessage secret key. (multi: O, single: -)
# LOOPMESSAGE_SECRET_KEY=
# LoopMessage sender name. (multi: O, single: -)
# LOOPMESSAGE_SENDER=
# LoopMessage iMessage opt-in link shown to clients. (multi: O, single: -)
# NEXT_PUBLIC_LOOPMESSAGE_OPTIN_URL=

# --- payments ---
# Platform fee percentage (forced to 0 in single mode). (multi: O, single: -)
# PLATFORM_FEE_PERCENT=

# --- domains ---
# Custom-domain backend: vercel or none. (multi: O, single: -)
# DOMAINS_PROVIDER=
# Domain-to-tenant map: global-config, static or none. (multi: O, single: -)
# DOMAIN_MAP_PROVIDER=
# Vercel API token for custom domains. (multi: R, single: -)
# VERCEL_TOKEN=
# Vercel project id for custom domains. (multi: R, single: -)
# VERCEL_PROJECT_ID=
# Vercel team id for custom domains. (multi: R, single: -)
# VERCEL_TEAM_ID=
# Vercel Global Config connection string (replaces EDGE_CONFIG). (multi: R, single: -)
# GLOBAL_CONFIG=
# Vercel Global Config id (replaces EDGE_CONFIG_ID). (multi: R, single: -)
# GLOBAL_CONFIG_ID=
# Legacy name for GLOBAL_CONFIG (read implicitly by @vercel/edge-config). (multi: O, single: -)
# EDGE_CONFIG=
# Legacy name for GLOBAL_CONFIG_ID. (multi: O, single: -)
# EDGE_CONFIG_ID=
# Static domain map: host=slug,host=slug (DOMAIN_MAP_PROVIDER=static). (multi: O, single: -)
# UPTEMPO_DOMAIN_MAP=

# --- push ---
# Apple push key id. (multi: O, single: -)
# APNS_KEY_ID=
# Apple developer team id. (multi: O, single: -)
# APNS_TEAM_ID=
# Apple push private key (.p8 contents). (multi: O, single: -)
# APNS_PRIVATE_KEY=
# App Store review login email (fixed OTP). (multi: O, single: -)
# REVIEW_OTP_EMAIL=
# App Store review fixed OTP code. (multi: O, single: -)
# REVIEW_OTP_CODE=

# --- analytics ---
# Google Analytics measurement id; GA is off when unset. (multi: O, single: O)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# PostHog project token; PostHog is off when unset. (multi: O, single: O)
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# PostHog host. (multi: O, single: O)
# NEXT_PUBLIC_POSTHOG_HOST=

# --- build ---
# Set to 1 to build Next.js in standalone output mode. (multi: O, single: O)
# BUILD_STANDALONE=

# --- compose ---
# Docker Compose profiles to enable. (multi: -, single: O)
# COMPOSE_PROFILES=
# Postgres user for the bundled compose database. (multi: -, single: O)
# POSTGRES_USER=
# Postgres password for the bundled compose database. (multi: -, single: O)
# POSTGRES_PASSWORD=
# Postgres database name for the bundled compose database. (multi: -, single: O)
# POSTGRES_DB=
# Host port published by compose. (multi: -, single: O)
# UPTEMPO_PORT=

# --- dev-scripts ---
# Env file path for scripts/migrate-*-calendar.ts (default .env.local). (multi: -, single: -)
# ENV_FILE=
# Env file override for scripts/send-test-template-emails.ts. (multi: -, single: -)
# USE_TEMPLATE_EMAIL_ENV=
